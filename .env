# Copy to .env and change every password.
CLUSTER_NAME=pg-ha

POSTGRES_PASSWORD=change-me-superuser
REPLICATION_PASSWORD=change-me-replication
REWIND_PASSWORD=change-me-rewind
PATRONI_API_PASSWORD=change-me-patroni-api

APP_DB=appdb
APP_USER=app
APP_PASSWORD=change-me-app

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-pgadmin

# PgBouncer
POOL_MODE=transaction
MAX_CLIENT_CONN=2000
DEFAULT_POOL_SIZE=40

# 127.0.0.1 = only this machine can reach the ports. Use 0.0.0.0 to expose on the network.
BIND_ADDR=127.0.0.1
